# /etc/systemd/system/camera-api.service
#
# FastAPI camera gateway.
# Enable with:
#   systemctl enable --now camera-api

[Unit]
Description=Camera API – BPM Lab
Documentation=https://lab.bpm.in.tum.de/camera-api/docs
After=network.target camera-capture@whiteboard.service camera-capture@robot.service
Wants=camera-capture@whiteboard.service camera-capture@robot.service

[Service]
Type=simple
User=camera-service
Group=camera-service

WorkingDirectory=/opt/camera-service

Environment=CAMERA_SERVICE_CONFIG=/etc/camera-service/production.yaml

ExecStart=/opt/camera-service/.venv/bin/uvicorn api.main:app \
    --host 127.0.0.1 \
    --port 8100 \
    --workers 2 \
    --log-level info \
    --access-log

Restart=on-failure
RestartSec=5s
StartLimitBurst=5
StartLimitIntervalSec=60s

# Harden
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=false
ReadWritePaths=/var/lib/camera-service

StandardOutput=journal
StandardError=journal
SyslogIdentifier=camera-api

[Install]
WantedBy=multi-user.target
