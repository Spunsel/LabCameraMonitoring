# /etc/systemd/system/camera-api.service
#
# FastAPI camera gateway.
# Enable with:
#   systemctl enable --now camera-api

[Unit]
Description=Camera API – BPM Lab
After=network.target camera-capture@whiteboard.service camera-capture@robot.service
Wants=camera-capture@whiteboard.service camera-capture@robot.service
StartLimitBurst=5
StartLimitIntervalSec=60s

[Service]
Type=simple
User=lab
Group=lab
SupplementaryGroups=video

WorkingDirectory=/home/lab/camera-service

Environment=CAMERA_SERVICE_CONFIG=/home/lab/camera-service/config/production.yaml
EnvironmentFile=-/etc/camera-service/controls.env

ExecStart=/home/lab/camera-service/.venv/bin/uvicorn api.main:app \
    --host 127.0.0.1 \
    --port 8100 \
    --workers 1 \
    --log-level info \
    --access-log

Restart=on-failure
RestartSec=5s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=camera-api

[Install]
WantedBy=multi-user.target
