# /etc/systemd/system/camera-capture@.service
#
# Parameterized µStreamer unit – one instance per camera.
# Enable with:
#   systemctl enable --now camera-capture@whiteboard
#   systemctl enable --now camera-capture@robot   (after second camera is connected)
#
# Each instance reads its config from /etc/camera-service/{instance}.env
# Required variables: DEVICE, PORT, RESOLUTION, FPS

[Unit]
Description=µStreamer camera capture – %i
Documentation=https://github.com/pikvm/ustreamer
After=network.target
StartLimitBurst=5
StartLimitIntervalSec=60s

[Service]
Type=simple
User=lab
Group=video

EnvironmentFile=/etc/camera-service/%i.env

ExecStart=/usr/bin/ustreamer \
    --device=${DEVICE} \
    --host=127.0.0.1 \
    --port=${PORT} \
    --resolution=${RESOLUTION} \
    --format=MJPEG \
    --desired-fps=${FPS}

Restart=on-failure
RestartSec=5s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=camera-capture@%i

[Install]
WantedBy=multi-user.target
